# Comma-separated list of valid API keys
API_KEYS=

# Xero Multi-App OAuth2 Configuration
# App 1 Configuration
XERO_APP1_CLIENT_ID=your_app1_client_id_here
XERO_APP1_CLIENT_SECRET=your_app1_client_secret_here

# App 2 Configuration
XERO_APP2_CLIENT_ID=your_app2_client_id_here
XERO_APP2_CLIENT_SECRET=your_app2_client_secret_here

# App 3 Configuration
XERO_APP3_CLIENT_ID=your_app3_client_id_here
XERO_APP3_CLIENT_SECRET=your_app3_client_secret_here

# App 4 Configuration
XERO_APP4_CLIENT_ID=your_app4_client_id_here
XERO_APP4_CLIENT_SECRET=your_app4_client_secret_here

# Legacy support (for backward compatibility)
XERO_CLIENT_ID=your_legacy_client_id_here
XERO_CLIENT_SECRET=your_legacy_client_secret_here

# App Distribution Strategy (optional)
# Format: tenant_id:app_id,tenant_id:app_id
XERO_TENANT_APP_MAPPING=

# App Distribution Mode: auto, manual, round_robin
XERO_APP_DISTRIBUTION_MODE=round_robin

# Redirect URI (must match what's configured in your Xero Apps)
XERO_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Optional: Customize scopes if needed
# XERO_SCOPE=offline_access accounting.transactions accounting.contacts

# Application settings
APP_NAME=Finance Assistant
DEBUG=true 