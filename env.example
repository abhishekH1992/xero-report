# Comma-separated list of valid API keys
API_KEYS=

# Xero OAuth2 Configuration
# Get these from your Xero App in the Xero Developer Portal
XERO_CLIENT_ID=your_client_id_here
XERO_CLIENT_SECRET=your_client_secret_here

# Redirect URI (must match what's configured in your Xero App)
XERO_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback

# Optional: Customize scopes if needed
# XERO_SCOPE=offline_access accounting.transactions accounting.contacts

# Application settings
APP_NAME=Finance Assistant
DEBUG=true 